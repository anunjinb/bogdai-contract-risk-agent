# BogdAI Contract Risk Agent - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Microsoft Foundry / Azure AI Project endpoint
AZURE_AI_PROJECT_ENDPOINT=https://your-foundry-project-endpoint

# Azure OpenAI model deployment name (e.g., gpt-4o)
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o

# BogdAI runtime flags
# Set to true to enable Microsoft Foundry calls
BOGDAI_USE_FOUNDRY=true

# Set to true to allow local deterministic fallback if Foundry is unavailable
BOGDAI_ALLOW_LOCAL_FALLBACK=true
